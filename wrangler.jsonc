// Cloudflare Workers config: serves public/ as static assets (public/app.js is built from src/ with npm run build and committed).
{
  "name": "ngepunk",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public"
  },
  "workers_dev": false,
  "routes": [{ "pattern": "ngepunk.alviy.dev", "custom_domain": true }]
}
